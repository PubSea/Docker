// OTLP in (gRPC :4317, HTTP :4318) -> batch -> Tempo (traces), Mimir (metrics), Loki (logs)

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.otlphttp.mimir.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

otelcol.exporter.otlphttp "mimir" {
  client {
    endpoint = "http://mimir:9009/otlp"
  }
}

// Loki's native OTLP endpoint: service.name becomes the service_name label,
// trace_id / span_id / attributes become structured metadata (no JSON blobs).
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

// ---------------------------------------------------------------------------
// NATS JetStream cluster (../NATS): scrape the prometheus-nats-exporter
// sidecars on shared_network and write the samples to Mimir, the default
// Grafana datasource. Source of truth: NATS/monitoring/alloy-nats.alloy
// Apply after editing: curl -X POST http://localhost:3400/-/reload
// Targets that are not running yet simply report up == 0.
// ---------------------------------------------------------------------------
prometheus.scrape "nats" {
  job_name        = "nats"
  scrape_interval = "15s"
  scrape_timeout  = "10s"

  targets = [
    {"__address__" = "nats-1-exporter:7777"},
    {"__address__" = "nats-2-exporter:7777"},
    {"__address__" = "nats-3-exporter:7777"},
  ]

  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}
