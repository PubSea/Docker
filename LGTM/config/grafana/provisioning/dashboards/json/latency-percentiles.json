{
  "uid": "lgtm-latency-percentiles",
  "title": "Service Latency Percentiles",
  "tags": [
    "tempo",
    "span-metrics",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "P50\u2013P99.99 from Tempo span-metrics native histograms stored in Mimir. Default span kind SERVER = real incoming requests.",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "svc"
        },
        "definition": "label_values(traces_spanmetrics_calls_total, service)"
      },
      {
        "name": "span_kind",
        "label": "Span kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=\"$service\"}, span_kind)",
          "refId": "kind"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=\"$service\"}, span_kind)",
        "description": "SPAN_KIND_SERVER = incoming requests (default). CLIENT = DB / downstream calls.",
        "current": {
          "text": "SPAN_KIND_SERVER",
          "value": "SPAN_KIND_SERVER"
        }
      },
      {
        "name": "span_name",
        "label": "Operation",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=\"$service\", span_kind=~\"$span_kind\"}, span_name)",
          "refId": "span"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=\"$service\", span_kind=~\"$span_kind\"}, span_name)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.5, sum(rate(traces_spanmetrics_latency{service=\"$service\", span_kind=~\"$span_kind\", span_name=~\"$span_name\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "exemplar": true
        },
        {
          "refId": "B",
