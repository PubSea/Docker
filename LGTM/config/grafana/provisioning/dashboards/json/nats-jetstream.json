{
  "uid": "nats-jetstream-cluster",
  "title": "NATS JetStream cluster",
  "tags": [
    "nats",
    "jetstream"
  ],
  "description": "NATS/ stack: 3-server JetStream cluster on one Docker host. Metrics from prometheus-nats-exporter via Alloy -> Mimir. Alerts: NATS/monitoring/nats-alerts.yml.",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "stream",
        "label": "Stream",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "query": {
          "query": "label_values(jetstream_stream_total_messages{job=\"nats\"}, stream_name)",
          "refId": "stream"
        },
        "definition": "label_values(jetstream_stream_total_messages{job=\"nats\"}, stream_name)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Cluster",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Servers ready",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Servers whose /healthz passes (meta quorum + all local replicas current). 3 = healthy, 2 = degraded but writable, <2 = quorum lost.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "count(gnatsd_healthz_status{job=\"nats\"} == 0) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Meta leader",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Server currently leading the JetStream meta group.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (meta_leader) (jetstream_server_total_streams{job=\"nats\", is_meta_leader=\"true\"})",
          "legendFormat": "{{meta_leader}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Client connections",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "All client connections across the cluster.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(gnatsd_varz_connections{job=\"nats\"})",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Streams",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Streams hosted (largest per-server count).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(jetstream_server_total_streams{job=\"nats\"})",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "File storage used (worst server)",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "JetStream file storage used / max_file_store on the fullest server.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(gnatsd_varz_jetstream_stats_storage{job=\"nats\"} / gnatsd_varz_jetstream_config_max_storage{job=\"nats\"})",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Slow consumers (1h)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(gnatsd_varz_slow_consumers{job=\"nats\"}[1h])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "/healthz per server (0 = ready, 1 = not ready, gap = unreachable)",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Readiness as seen by each exporter: JetStream meta quorum reachable and every replica on the server current.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "gnatsd_healthz_status{job=\"nats\"}",
          "legendFormat": "{{server_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Exporter scrape status (up)",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "up{job=\"nats\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Traffic",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Messages per second",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Includes route and JetStream replication traffic.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (server_id) (rate(gnatsd_varz_in_msgs{job=\"nats\"}[$__rate_interval]))",
          "legendFormat": "{{server_id}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (server_id) (rate(gnatsd_varz_out_msgs{job=\"nats\"}[$__rate_interval]))",
          "legendFormat": "{{server_id}} out"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bytes per second",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (server_id) (rate(gnatsd_varz_in_bytes{job=\"nats\"}[$__rate_interval]))",
          "legendFormat": "{{server_id}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (server_id) (rate(gnatsd_varz_out_bytes{job=\"nats\"}[$__rate_interval]))",
          "legendFormat": "{{server_id}} out"
        }
      ]
    },
    {
      "type": "row",
      "title": "Resources",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memory vs GOMEMLIMIT",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "gnatsd_varz_mem{job=\"nats\"}",
          "legendFormat": "{{server_id}} rss"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(gnatsd_varz_gomemlimit{job=\"nats\"})",
          "legendFormat": "GOMEMLIMIT"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU (% of the cores the server may use)",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "gnatsd_varz_cpu{job=\"nats\"} / gnatsd_varz_gomaxprocs{job=\"nats\"}",
          "legendFormat": "{{server_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JetStream file storage",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "gnatsd_varz_jetstream_stats_storage{job=\"nats\"}",
          "legendFormat": "{{server_id}} used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "gnatsd_varz_jetstream_stats_reserved_storage{job=\"nats\"}",
          "legendFormat": "{{server_id}} reserved (max_bytes)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(gnatsd_varz_jetstream_config_max_storage{job=\"nats\"})",
          "legendFormat": "max_file_store"
        }
      ]
    },
    {
      "type": "row",
      "title": "Streams and consumers",
      "id": 17,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Stream messages per replica",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "One series per server holding a replica. R3 streams must show three equal lines.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (stream_name, server_name) (jetstream_stream_total_messages{job=\"nats\", stream_name=~\"$stream\"})",
          "legendFormat": "{{stream_name}} @ {{server_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Replica spread (max - min last sequence)",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Messages the slowest replica is behind the most advanced one. Should hover near 0.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (stream_name) (jetstream_stream_last_seq{job=\"nats\", stream_name=~\"$stream\"}) - min by (stream_name) (jetstream_stream_last_seq{job=\"nats\", stream_name=~\"$stream\"})",
          "legendFormat": "{{stream_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer pending (unprocessed) and ack pending",
      "id": 20,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (stream_name, consumer_name) (jetstream_consumer_num_pending{job=\"nats\", stream_name=~\"$stream\"})",
          "legendFormat": "{{stream_name}} > {{consumer_name}} pending"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max by (stream_name, consumer_name) (jetstream_consumer_num_ack_pending{job=\"nats\", stream_name=~\"$stream\"})",
          "legendFormat": "{{stream_name}} > {{consumer_name}} ack pending"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer redeliveries in progress",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
