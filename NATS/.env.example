# Copy to .env (scripts/setup.sh does it). .env is gitignored, but it must
# still never contain secrets: credentials live in ./secrets, keys in ./certs.

# ---------------------------------------------------------------------------
# UID/GID the containers run as: the non-root host user that owns ./secrets,
# ./certs and ./backups. scripts/setup.sh fills these in with `id -u` / `id -g`.
# ---------------------------------------------------------------------------
# NATS_UID=
# NATS_GID=

# ---------------------------------------------------------------------------
# Images. docker-compose.yaml pins tag + multi-arch digest (verified
# 2026-11-06). Override here only for a deliberate rolling upgrade
# (README: "Rolling restart and upgrade"), never with a floating tag.
# ---------------------------------------------------------------------------
# NATS_IMAGE=nats:2.15.2-alpine3.22@sha256:afae2fdbe2e326c65e1246cb83b9d05d319188734f3bd577ac8072daae78a10f
# NATS_BOX_IMAGE=natsio/nats-box:0.20.2@sha256:5162fca0f56ebe6f78e612e1ded143ce978e088393476033020e6251358dba6f
# NATS_EXPORTER_IMAGE=natsio/prometheus-nats-exporter:0.20.3@sha256:4b8ddc1c86fec360b5cd3d5e1fbc6fb52bdafd5805bba3901cc52926538af255

# ---------------------------------------------------------------------------
# Host exposure of the TLS client port. 127.0.0.1 = processes on this Docker
# host only. For remote clients set 0.0.0.0, firewall the ports, and add the
# host's DNS name/IP to NATS_TLS_EXTRA_SANS before running scripts/pki.sh.
# Route (6222) and monitoring (8222) ports are never published.
# ---------------------------------------------------------------------------
NATS_CLIENT_BIND=127.0.0.1
NATS_1_CLIENT_PORT=4222
NATS_2_CLIENT_PORT=4223
NATS_3_CLIENT_PORT=4224

# ---------------------------------------------------------------------------
# TLS. Extra subjectAltNames for every node certificate, comma separated in
# OpenSSL syntax, e.g. DNS:nats.example.com,IP:192.0.2.10
# Leaf certificate lifetime in days (the private CA lives 10 years).
# ---------------------------------------------------------------------------
NATS_TLS_EXTRA_SANS=
NATS_TLS_LEAF_DAYS=397

# ---------------------------------------------------------------------------
# Sizing per server. ASSUMPTIONS, not measurements: a few thousand msgs/s of
# <=1 KiB messages, <=1,000 client connections, <=100 streams, file storage,
# and a Docker disk with >= 3 x NATS_JS_MAX_FILE + 20% free (all three volumes
# share one disk on a single host). Measure and adjust (README: "Sizing").
# ---------------------------------------------------------------------------
NATS_CPUS=2
NATS_MEMORY_LIMIT=2g
# Open-file limit (connections + ~2 per stream); must be <= the Docker daemon's hard limit.
NATS_NOFILE=65536
# ~80% of NATS_MEMORY_LIMIT; Go's soft limit, keeps GC ahead of the cgroup OOM killer.
NATS_GOMEMLIMIT=1600MiB
# JetStream caps per server (each server stores one replica of every R3 stream).
NATS_JS_MAX_MEMORY=512MB
NATS_JS_MAX_FILE=10GB

# ---------------------------------------------------------------------------
# Backups (scripts/backup.sh). Local copies to keep, and an optional off-host
# copy: rclone remote:path configured in secrets/rclone.conf (README section
# "Backup and restore"), e.g. seaweed:nats-backups
# ---------------------------------------------------------------------------
NATS_BACKUP_KEEP=7
NATS_BACKUP_REMOTE=
